# Ghostty Configuration

# Copy/Paste (standard macOS)
keybind = cmd+c=copy_to_clipboard
keybind = cmd+v=paste_from_clipboard

# Tab management
keybind = cmd+t=new_tab
keybind = cmd+w=close_surface
keybind = cmd+shift+left_bracket=previous_tab
keybind = cmd+shift+right_bracket=next_tab

# Split panes
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down

# Font size
keybind = cmd+plus=increase_font_size:1
keybind = cmd+minus=decrease_font_size:1
keybind = cmd+zero=reset_font_size

# Scrolling
keybind = cmd+up=scroll_to_top
keybind = cmd+down=scroll_to_bottom
keybind = page_up=scroll_page_up
keybind = page_down=scroll_page_down

# Clear screen
keybind = cmd+k=clear_screen

# Word navigation - send escape sequences to shell
# Option+Left/Right for word navigation (sends escape sequences)
keybind = alt+left=text:\x1bb
keybind = alt+right=text:\x1bf

# Line editing - send to shell
keybind = cmd+backspace=text:\x15
