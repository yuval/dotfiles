# Safety guardrails mirroring claude/settings.json deny list

prefix_rule(
    pattern = ["rm"],
    decision = "forbidden",
    justification = "Destructive file removal requires manual execution",
    match = [
        "rm file.txt",
        "rm -rf /tmp/build",
    ],
)

prefix_rule(
    pattern = ["sudo"],
    decision = "forbidden",
    justification = "Elevated privileges require manual execution",
    match = [
        "sudo rm -rf /",
        "sudo apt install foo",
    ],
)

prefix_rule(
    pattern = ["git", "push", ["--force", "-f"]],
    decision = "forbidden",
    justification = "Force pushing can destroy remote history",
    match = [
        "git push --force origin main",
        "git push -f origin main",
    ],
    not_match = [
        "git push origin main",
    ],
)

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "Hard reset discards uncommitted work",
    match = [
        "git reset --hard HEAD~1",
        "git reset --hard origin/main",
    ],
    not_match = [
        "git reset HEAD~1",
    ],
)

prefix_rule(
    pattern = ["git", "checkout", "--", "."],
    decision = "forbidden",
    justification = "git checkout -- . discards all uncommitted changes",
    match = [
        "git checkout -- .",
    ],
)

prefix_rule(
    pattern = ["git", "clean"],
    decision = "forbidden",
    justification = "git clean permanently deletes untracked files",
    match = [
        "git clean -fd",
        "git clean -f",
    ],
)
